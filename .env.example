# ── PolyTranslate AI ──────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit real secrets.

# App
APP_ENV=development
APP_NAME=PolyTranslate AI
APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database (compose overrides with postgres)
DATABASE_URL=sqlite:///./polytranslate.db
# DATABASE_URL=postgresql://polytranslate:polytranslate@db:5432/polytranslate

# Cache (optional — in-memory fallback when empty)
REDIS_URL=

# AI provider: auto | gemini | openai
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Uploads
MAX_FILE_SIZE_MB=10
MAX_DOCUMENT_CHARS=50000
MAX_AUDIO_MB=25

# Rate limits
RATE_LIMIT_ANON=30/minute
RATE_LIMIT_AUTH=120/minute

# Usage caps (characters / month)
FREE_MONTHLY_CHARACTERS=50000
PRO_MONTHLY_CHARACTERS=2000000
BUSINESS_MONTHLY_CHARACTERS=10000000

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
